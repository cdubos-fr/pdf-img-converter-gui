# Configuration pour un environnement Python simple
# Surveille les changements dans pyproject.toml et tox.ini
watch_file pyproject.toml pdm.lock tox.ini

# Crée l'environnement virtuel s'il n'existe pas
if [ ! -d .venv ]; then
    echo "Création de l'environnement virtuel..."
    pdm lock
    tox devenv -e devenv .venv
    pre-commit install
fi

# Active l'environnement virtuel
if [ -d .venv ]; then
    source .venv/bin/activate
fi

# Variables d'environnement pour les bibliothèques GUI
export DISPLAY=${DISPLAY:-:0}
export QT_X11_NO_MITSHM=1
